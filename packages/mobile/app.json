{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.appId.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://204-13-236-153.sslip.io/",
      "applicationId": "natex-pshh6q6",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.appId.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "runable-natex-pshh6q6",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "NatEx uses the camera to photograph parcels at the doorstep as proof of delivery.",
          "photosPermission": false
        }
      ]
    ]
  }
}