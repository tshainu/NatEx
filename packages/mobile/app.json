{
  "expo": {
    "name": "NX Official",
    "slug": "nxt",
    "owner": "shainoo",
    "version": "1.0.0",
    "scheme": "runable-natex-pshh6q6",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/nx-official-icon.png",
    "android": {
      "package": "com.natex.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.natex.rider",
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "9e45406f-5cb6-4207-948e-af96d48611a1"
      },
      "apiUrl": "https://204-13-236-153.sslip.io/",
      "applicationId": "natex-pshh6q6",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "NatEx uses the camera to photograph parcels at the doorstep as proof of delivery.",
          "photosPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NatEx uses the camera to scan parcel barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ]
  }
}
