# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# NatEx (see README.md "Configuration" and RUNBOOK.md)
# MUST be NODE_ENV=production in production: dev affordances (sign-in devCodes,
# seeded MFA factors, fallback keys) are on only for an explicit development/test.
# Long random strings. Required outside development — the server refuses to sign tokens without them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Long random string (hashed to an AES-256 key) — encrypts TOTP secrets at rest. Required in production; changing it invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=
SMS_EXECUTION_URL=
SMS_SENDER_ID=
SMS_DLR_WEBHOOK_SECRET=
# Optional: hour (Asia/Colombo) of the nightly COD invariant run, default 23; tick in ms, default 300000.
NIGHTLY_INVARIANT_HOUR=
NIGHTLY_TICK_MS=
# Not wired yet — supply a DSN to turn on error reporting (src/api/shared/report-error.ts).
SENTRY_DSN=
